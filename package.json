{
  "name": "synchive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "node server.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write",
    "test": "node --import ./test/register.mjs --test \"test/*.test.ts\"",
    "test:browser": "node test/browser/hlsPlayer.smoke.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "start": "node ./dist/server.js",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "dompurify": "^3.4.16",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.52.0",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@netlify/functions": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.2"
  },
  "license": "MIT"
}
